@using static DelitaTrade.Common.Constants.FormatConstant.DateTimeFormat;

@model ReturnProtocolEditModel;

@{
    ViewData["Title"] = "Delete Return Protocol";
}

<div>
    <h2><strong>@ViewData["Title"]</strong></h2>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="@Model.Id" value="@Model.Id"/>
        <div class="alert alert-danger">
            <p>Are you sure you want to delete the return protocol for <strong>@Model.CompanyObjectName</strong> from date: <strong>@Model.ReturnDate?.ToString(AppDateFormat)</strong> ?</p>
        </div>
        <a asp-controller="ReturnProtocol" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>