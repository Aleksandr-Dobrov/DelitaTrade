@using DelitaTrade.Common.Extensions
@using DelitaTrade.Core.ViewModels.InvoiceModels;

@model DelitaTrade.Core.ViewModels.InvoiceModels.InvoiceInDayReportAdvanceInputModel;

@{
    ViewData["Title"] = "Advance pay";
}

<head>
    @section Style{
        <link rel="stylesheet" href="~/css/DayReport/DayReportBackground.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/Invoice/AdvancePayStyles.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    }
</head>

<div class="row">
    <div class="main-box light-gray-80 delita-shadow main-container">
        <div class="advance-row">
            <h2><strong>@ViewData["Title"]</strong></h2>
        </div>
        <div class="advance-row advance-border">
            <div>
                <label>Number</label>
                <p class="font-size-delivery"><strong>@Model.InvoiceNumber</strong></p>
            </div>
            <div>
                <label>Balance</label>
                <p><strong>@Model.Balance.ToLev()</strong></p>
                <p><strong>@Model.Balance.LevToEuro()</strong></p>
            </div>
            <div>
                <label>Amount</label>
                <p><strong>@Model.Amount.ToLev()</strong></p>
                <p><strong>@Model.Amount.LevToEuro()</strong></p>
            </div>
        </div>
        <form asp-controller="Invoice" asp-action="AdvancePay" method="post"> 
            <input asp-for="@Model.DeliveryId" type="hidden" value="@Model.DeliveryId"/>
            <input asp-for="@Model.DayReportId" type="hidden" value="@Model.DayReportId" />
            <input asp-for="@Model.InvoiceNumber" type="hidden" value="@Model.InvoiceNumber" />
            <input asp-for="@Model.Amount" type="hidden" value="@Model.Amount" />
            <input asp-for="@Model.Balance" type="hidden" value="@Model.Balance" />
            <input asp-for="@Model.Paid" type="hidden" value="@Model.Paid" />
            
            <div class="advance-row"> 
                <div class="mb-2">
                    <label asp-for="@Model.ReasonId" class="form-label-add-edit">Reason</label>
                    <select asp-for="@Model.ReasonId" id="trader-input" class="form-control" aria-required="true" asp-items="@(new SelectList(Model.Reasons, "Id", "Name"))">
                        <option value="">...</option>
                    </select>
                    <span asp-validation-for="@Model.ReasonId" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="@Model.PaymentTypeId" class="form-label-add-edit">Payment type</label>
                    <select asp-for="@Model.PaymentTypeId" id="trader-input" class="form-control" aria-required="true" asp-items="@(new SelectList(Model.PaymentTypes, "Id", "Name"))">
                        <option value="">...</option>
                    </select>
                    <span asp-validation-for="@Model.PaymentTypeId" class="text-danger"></span>
                </div>
                <div class="mb-2">                
                    <label asp-for="@Model.Income" class="form-label-add-edit">Income</label>
                    <input asp-for="@Model.Income" class="form-control" type="number" aria-required="true" />
                    <span asp-validation-for="@Model.Income" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-2 advance-row">
                <div>
                    <a asp-controller="Delivery" asp-action="Details" asp-route-id="@Model.DeliveryId" class="btn btn-primary btn-dark-text w-100 py-2 fw-bold rounded">
                        <i class="fa-solid fa-square-xmark"></i> Cancel
                    </a>
                </div>
                <div>
                    <button class="btn btn-warning btn-dark-text w-100 py-2 fw-bold rounded" type="submit">
                        <i class="fa-solid fa-check"></i> Complete
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}