@using DelitaTrade.Common.Extensions
@using DelitaTrade.Core.ViewModels
@using DelitaTrade.Common.Enums;
@using static DelitaTrade.Common.Constants.FormatConstant.DateTimeFormat;

@model DayReportViewModel
@{
    ViewData["Title"] = $"Daily Report for {Model.FormattedDate}";
    ViewData["CashDifference"] = (Model.TotalIncome - Model.TotalCash).ToString("C");
    var companyObjects = Model.Invoices.GroupBy(i => i.CompanyObject.Id).ToList();    
}

<head>
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ReturnProtocol/returnProtocol.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/DayReport/DayReport.css" asp-append-version="true" />
</head>

<div class="delita-shadow">
    <main>
        <div class="details-display light-gray-80">
            <div class="light-gray-80 protocol-detail">
                <h2>Date of report: <strong>@Model.FormattedDate</strong>г.</h2>
                <h4>Employee: <strong>@Model.User.Name</strong></h4>
                <div class="protocol-authors">
                    <div>
                        <p>Total amount: <strong>@Model.TotalAmount</strong></p>
                        <p>Total income: <strong>@Model.TotalIncome</strong></p>
                        <p>Total cash: <strong>@Model.TotalCash</strong></p>
                        <p>Cash difference: <strong>@ViewData["CashDifference"]</strong></p>
                    </div>
                    <div>
                        <p>Objects count: <strong>@companyObjects.Count(o => o.Any(i => i.PayMethod != PayMethod.Expense))</strong></p>
                        <p>Invoice count: <strong>@Model.Invoices.Count</strong></p>
                    </div>
                </div>
            </div>        
        </div>
    </main>
</div>
<div class="products-list gray-70">
    @if (companyObjects.Any())
    {
        foreach(var companyObject in companyObjects)
        {
            decimal amount = companyObject.Sum(o => o.Amount);
            IEnumerable<int> invoiceIds = companyObject.Select(o => o.IdInDayReport);
            <div class="day-report-list-container">
                <a asp-controller="Invoice" asp-action="Details" asp-route-invoiceIds="@string.Join(',', invoiceIds)">
                    <div class="light-gray-80 day-report-list-item">
                        <p>@companyObject.First().CompanyObject.Name</p>
                        <div class="totals">
                            <div>
                                <p>income:</p>
                                <p><strong>@companyObject.Sum(i => i.Income).ToLev()</strong></p>
                                <p><strong>@companyObject.First().PayMethod.Translate()</strong></p>
                            </div>
                            <div>
                                <p>Amount:</p>
                                <p><strong>@amount.ToLev()</strong></p>
                                <p><strong>@amount.ToEuro()</strong></p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
</div>
    <a asp-action="Index" class="btn btn-primary">Back to Reports</a>
